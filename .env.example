# ==================================================
# TravelMate AI - Environment Variables Template
# ==================================================
# Copy this file to:
# 1. server/.env (for backend configuration)
# 2. client/.env (for frontend configuration, if needed)

# --------------------------------------------------
# BACKEND CONFIGURATION (server/.env)
# --------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database URL for Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelmate_db?schema=public"

# JWT Secret for Session & Authentication (Stage 2)
JWT_SECRET="travelmate_super_secret_jwt_key_academic_project_2026"
JWT_EXPIRES_IN="7d"

# Google Gemini API Key (Stage 14)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Razorpay Test Mode Credentials (Stage 10)
# Get test keys from Razorpay Dashboard: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# --------------------------------------------------
# FRONTEND CONFIGURATION (client/.env)
# --------------------------------------------------
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_APP_NAME="TravelMate AI"
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
