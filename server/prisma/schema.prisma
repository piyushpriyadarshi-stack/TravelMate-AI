// ==================================================
// TravelMate AI - Prisma Database Schema
// Database: PostgreSQL
// ==================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------
// ENUMS
// --------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum HotelCategory {
  BUDGET
  THREE_STAR
  FOUR_STAR
  FIVE_STAR
  LUXURY
  RESORT
  BOUTIQUE
  BUSINESS
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  DELUXE
  SUITE
  FAMILY
  PREMIUM
  EXECUTIVE
  VILLA
  COTTAGE
  CLUB
}

enum TransportType {
  FLIGHT
  TRAIN
  BUS
  CAB
  PRIVATE_CAR
  SUV
  RENTAL_CAR
}

enum BookingStatus {
  PENDING
  PAYMENT_PROCESSING
  CONFIRMED
  CANCELLED
  FAILED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// --------------------------------------------------
// MODELS
// --------------------------------------------------

// 1. User Model
model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String?
  cognitoSub   String?   @unique
  googleId     String?   @unique
  authProvider String    @default("LOCAL")
  avatar       String?
  phone        String?
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  admin        Admin?
  bookings     Booking[]

  @@map("users")
}

// 2. Admin Model (Extension for administrative role)
model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique
  permissions String[] @default(["ALL"])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// 3. Destination Model
model Destination {
  id               String      @id @default(uuid())
  name             String
  city             String
  state            String?
  country          String
  countryCode      String?
  description      String
  shortDescription String?
  imageUrl         String
  galleryImages    String[]    @default([])
  latitude         Float?
  longitude        Float?
  timezone         String?
  popular          Boolean     @default(false)
  popularity       Int         @default(0) // 1-100 rating score
  status           String      @default("ACTIVE")
  attractions      String[]    @default([])
  isDomestic       Boolean     @default(true)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  hotels          Hotel[]
  activities      Activity[]
  bookings        Booking[]

  @@index([city, country])
  @@index([popularity])
  @@index([popular])
  @@index([status])
  @@map("destinations")
}

// 4. Cancellation Policy Model
model CancellationPolicy {
  id               String   @id @default(uuid())
  name             String
  description      String
  refundPercentage Float    @default(100.0) // E.g., 100 for full refund, 50 for half
  daysBeforeTrip   Int      @default(7)     // Must cancel >= X days before check-in for this policy
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  hotels           Hotel[]

  @@map("cancellation_policies")
}

// 5. Hotel Model
model Hotel {
  id                   String        @id @default(uuid())
  destinationId        String
  name                 String
  city                 String?
  state                String?
  country              String?
  countryCode          String?
  fullAddress          String?
  address              String        // Backward compatibility
  latitude             Float?
  longitude            Float?
  description          String
  shortDescription     String?
  category             HotelCategory @default(THREE_STAR)
  rating               Float?        @default(4.0) // 1.0 to 5.0
  officialWebsite      String?
  phone                String?
  email                String?
  checkInTime          String?       @default("14:00")
  checkOutTime         String?       @default("11:00")
  totalRooms           Int?          @default(10)
  availableRooms       Int?          @default(10)
  pricingMode          String        @default("DEVELOPMENT_TEST")
  liveAvailability     Boolean       @default(false)
  availabilityStatus   String        @default("REQUIRES_LIVE_CHECK")
  sourceUrl            String?
  verifiedAt           DateTime?
  imageUrls            String[]      @default([])
  amenities            String[]      @default([])
  pricePerNight        Float         // Base starting price per night
  cancellationPolicyId String?
  status               String        @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relations
  destination        Destination         @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  rooms              Room[]
  images             HotelImage[]
  bookingHotels      BookingHotel[]

  @@index([destinationId])
  @@index([city])
  @@index([country])
  @@index([category])
  @@index([latitude, longitude])
  @@index([pricePerNight])
  @@map("hotels")
}

// 6. Room Model
model Room {
  id             String    @id @default(uuid())
  hotelId        String
  name           String?
  type           RoomType  @default(DOUBLE)
  description    String?
  maxGuests      Int?      @default(2) // Max guests per room
  capacity       Int       @default(2)
  bedType        String?
  roomSize       String?
  price          Float?
  pricePerNight  Float
  currency       String    @default("INR")
  pricingMode    String    @default("DEVELOPMENT_TEST")
  totalRooms     Int?      @default(5)
  availableRooms Int?      @default(5)
  amenities      String[]  @default([])
  imageUrls      String[]  @default([])
  status         String    @default("AVAILABLE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookingHotels  BookingHotel[]

  @@index([hotelId])
  @@index([type])
  @@map("rooms")
}

// 6b. HotelImage Model
model HotelImage {
  id        String   @id @default(uuid())
  hotelId   String
  url       String
  type      String   @default("exterior") // exterior, room, bathroom, pool, restaurant, lobby, property
  alt       String?
  source    String?
  createdAt DateTime @default(now())

  // Relations
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("hotel_images")
}

// 7. Transportation Model
model Transportation {
  id             String        @id @default(uuid())
  type           TransportType
  provider       String        // Airline name, Bus operator, Car rental co.
  origin         String
  destination    String
  departureDate  DateTime?     // Scheduled date if applicable
  departureTime  String        // e.g. "06:30 AM"
  arrivalTime    String        // e.g. "09:00 AM"
  duration       String?       // e.g. "2h 30m"
  capacity       Int           @default(4) // Max passengers per unit
  availableSeats Int           @default(4)
  price          Float         // Price per passenger or vehicle
  status         String        @default("AVAILABLE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  bookingTransportations BookingTransportation[]

  @@index([origin, destination])
  @@index([type])
  @@map("transportations")
}

// 8. Activity Model
model Activity {
  id            String      @id @default(uuid())
  destinationId String
  name          String
  description   String
  duration      String      // e.g., "3 hours", "Half Day"
  price         Float
  imageUrl      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@map("activities")
}

// 9. Booking Model
model Booking {
  id             String        @id @default(uuid())
  bookingNumber  String        @unique // E.g., TM-2026-000001
  userId         String
  destinationId  String
  checkInDate    DateTime
  checkOutDate   DateTime
  travelerCount  Int           @default(1)
  hotelTotal     Float         @default(0.0)
  transportTotal Float         @default(0.0)
  activityTotal  Float         @default(0.0)
  taxAmount      Float         @default(0.0)
  discountAmount Float         @default(0.0)
  totalAmount    Float         @default(0.0)
  bookingStatus  BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  termsAccepted  Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination            Destination             @relation(fields: [destinationId], references: [id])
  bookingHotels          BookingHotel[]
  bookingTransportations BookingTransportation[]
  payments               Payment[]
  invoice                Invoice?

  @@index([userId])
  @@index([bookingStatus])
  @@index([checkInDate])
  @@map("bookings")
}

// 10. BookingHotel (Line item for hotel reservation in a booking)
model BookingHotel {
  id            String   @id @default(uuid())
  bookingId     String
  hotelId       String
  roomId        String
  roomCount     Int      @default(1)
  nights        Int      @default(1)
  pricePerNight Float
  totalPrice    Float
  createdAt     DateTime @default(now())

  // Relations
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel         Hotel    @relation(fields: [hotelId], references: [id])
  room          Room     @relation(fields: [roomId], references: [id])

  @@map("booking_hotels")
}

// 11. BookingTransportation (Line item for transportation in a booking)
model BookingTransportation {
  id               String         @id @default(uuid())
  bookingId        String
  transportationId String
  passengerCount   Int            @default(1)
  pricePerUnit     Float
  totalPrice       Float
  createdAt        DateTime       @default(now())

  // Relations
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transportation   Transportation @relation(fields: [transportationId], references: [id])

  @@map("booking_transportations")
}

// 12. Payment Model
model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String        @default("INR")
  provider      String        @default("RAZORPAY")
  orderId       String?       // Razorpay order ID (e.g. order_XXXXXXXX)
  transactionId String?       // Razorpay payment ID (e.g. pay_XXXXXXXX)
  signature     String?       // Razorpay verification signature
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?       // UPI, Card, NetBanking
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

// 13. Invoice Model
model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique // E.g., INV-TM-2026-000001
  bookingId     String   @unique
  totalAmount   Float
  pdfUrl        String?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  // Relations
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoices")
}
