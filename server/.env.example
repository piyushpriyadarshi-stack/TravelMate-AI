PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Connection String for Prisma
# Default format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelmate_db?schema=public"

# Authentication Secrets (Used starting Stage 2)
JWT_SECRET="travelmate_super_secret_jwt_key_academic_project_2026"
JWT_EXPIRES_IN="7d"

# Google Gemini API Key (Used starting Stage 14)
GEMINI_API_KEY=""

# Payment Gateways (Dual Gateway Adapter Architecture)
# 1. Razorpay (Domestic India: INR, UPI, RuPay, NetBanking)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# 2. Stripe (Global: USD, EUR, GBP, International Cards with 3DS)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Authorized Live Flight Data Provider (Amadeus Self-Service API)
# Get keys at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="test" # "test" or "production"
FLIGHT_PROVIDER="live" # "live" enforces AuthorizedLiveFlightProvider

# Amazon Cognito User Pools Configuration
COGNITO_USER_POOL_ID="us-east-1_travelmate"
COGNITO_CLIENT_ID="travelmate_web_client_id"
COGNITO_REGION="us-east-1"
COGNITO_DOMAIN="travelmate-auth.auth.us-east-1.amazoncognito.com"

# Clerk Authentication (Backend)
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Email Notification Configuration (Option 1: Resend API | Option 2: Gmail SMTP)
RESEND_API_KEY=""
EMAIL_FROM="TravelMate AI <onboarding@resend.dev>"
ADMIN_EMAIL="piyushpriyadarshi980@gmail.com"

# Optional Direct Gmail Delivery (Generate a Google App Password in Gmail Account Settings)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
